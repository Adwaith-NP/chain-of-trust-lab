# DNS
dns/server/
dns/dns_portal.db

# Social Lab
social/server/
social/uploads/
social/social.db
social/ca-root.pem
social/enroll.sh

# User machines: whole Firefox profiles (cookies, sessions, cache)
alice/
adwaith/

